# Leave blank: vite.config.ts proxies /api/* to http://10.81.70.203:81 during `npm run dev`.
VITE_API_BASE_URL=

# Local development MSAL configuration
VITE_AAD_CLIENT_ID=efcc0ac8-792f-465d-8803-b21de8b3f4b4
VITE_AAD_TENANT_ID=1562f007-09a4-4fcb-936b-e79246571fc7
# Vite dev server URL (default port 5173). Must be registered in Entra (see README).
VITE_AAD_REDIRECT_URI=http://localhost:5173/
VITE_AAD_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
# Scope exposed by the API app registration (Application ID URI + /access_as_user)
VITE_AAD_API_SCOPE=api://efcc0ac8-792f-465d-8803-b21de8b3f4b4/access_as_user


