# Leave blank: in production the SPA and the API live behind the same origin.
# IIS (see public/web.config) reverse-proxies /api/* to the backend, so the
# browser only ever sees relative URLs like /api/...  -> no CORS, no mixed content.
# Override per environment ONLY if you are forced to call a different origin.
VITE_API_BASE_URL=http://10.81.70.203:81/

# UAT/Production MSAL configuration
# IMPORTANT: rotate the previously leaked client secret in Entra (SPA does not need a secret).
VITE_AAD_CLIENT_ID=efcc0ac8-792f-465d-8803-b21de8b3f4b4
VITE_AAD_TENANT_ID=1562f007-09a4-4fcb-936b-e79246571fc7
VITE_AAD_REDIRECT_URI=https://test.hrmsnewgen.linde.com/signin-oidc
VITE_AAD_POST_LOGOUT_REDIRECT_URI=https://test.hrmsnewgen.linde.com/signin-oidc
# Scope exposed by the API app registration (Application ID URI + /access_as_user)
VITE_AAD_API_SCOPE=api://efcc0ac8-792f-465d-8803-b21de8b3f4b4/access_as_user
