<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!--
      SECURITY / SSO NOTES (Entra ID cutover):
      In IIS Manager for THIS site, set:
        - Authentication > Anonymous Authentication = ENABLED
        - Authentication > Windows Authentication   = DISABLED
      Token-based flow needs anonymous; protection is enforced by the API via JWT.
      Bind the site to HTTPS only (443) with a valid certificate for the host.
    -->
    <rewrite>
      <rules>
        <!-- Force HTTPS (defence in depth; primary enforcement is at the binding). -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Reverse proxy: forward /api requests to the backend server.
             Same-origin: keeps SPA -> API on a single host so no CORS is needed
             and the Bearer token is passed through transparently. -->
        <rule name="API Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://10.81.70.203:81/api/{R:1}" />
        </rule>
        <!-- SPA fallback: serve index.html for all other routes -->
        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <!-- HSTS: enforce HTTPS at the browser for 1 year. Add ; preload only after submitting to hstspreload.org. -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <location path="index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-store, no-cache, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
